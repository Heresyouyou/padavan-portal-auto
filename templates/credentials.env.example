# ============================================================
# 凭据占位文件（示例）
#
# 用法: 复制为 credentials.env 并填入真实值。
#       credentials.env 已被 .gitignore 忽略，不会被提交。
#
# ⚠️ 绝不要把填好的凭据提交到任何公开仓库!
# ============================================================

# ── 路由器 ──────────────────────────────────
ROUTER_IP=192.168.123.1
SSH_USER=admin
SSH_KEY=~/.ssh/router_key

# ── 校园网 Portal 认证 ──────────────────────
PORTAL_HOST=http://<PORTAL_HOST>:<PORT>
LOGIN_PATH=/zportal/loginForWeb
SUBMIT_PATH=/zportal/login/do
CAMPUS_USER=<YOUR_STUDENT_ID>
CAMPUS_PASS=<YOUR_PASSWORD>
SERVICE_ID=<YOUR_SERVICE_ID>

# ── 校内 DNS ────────────────────────────────
DNS1=<CAMPUS_DNS_1>
DNS2=<CAMPUS_DNS_2>

# ── MAC 克隆（如校园网绑定 MAC）────────────
MAC_CLONE=<AA:BB:CC:DD:EE:FF>
